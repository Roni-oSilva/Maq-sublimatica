# Supabase (Project Settings → API). A chave "anon" é pública por design; a segurança vem do RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do site (usada nos links de produto enviados no WhatsApp, sitemap e Open Graph).
# Local: http://localhost:3000 — Produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA coloque a chave service_role aqui nem no código: este projeto não precisa dela.
